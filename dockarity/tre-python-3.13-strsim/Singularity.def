# Bootstrap from the locally built Docker image.
# Build the Docker image first:
#   docker build -t tre-python-3.13-strsim:latest .
# Then build this SIF:
#   singularity build tre-python-3.13-strsim.sif Singularity.def

Bootstrap: docker-daemon
From: tre-python-3.13-strsim:latest

%environment
    export PATH="/opt/view/bin:/usr/local/bin:$PATH"
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    # Ensure the uv-managed Python 3.13 site-packages are importable
    export PYTHONPATH="$(find /opt/uv-python -name 'site-packages' -type d 2>/dev/null | head -1)"

%runscript
    exec python3.13 "$@"
